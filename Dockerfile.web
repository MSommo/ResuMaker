# Development image for the React app (Vite dev server with HMR). Source is bind-mounted by docker-compose.yml.
FROM node:22-alpine

WORKDIR /app
# node_modules is installed for Linux inside the image; a named volume keeps the host's (macOS) one out of the way.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

EXPOSE 5173
# `npm install` is a fast no-op normally, and picks up dependency changes made on the host.
CMD ["sh", "-c", "npm install --no-audit --no-fund && exec npm run dev -- --host 0.0.0.0"]
