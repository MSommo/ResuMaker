#!/usr/bin/env bash
# Fast local checks before every commit: the same frontend checks CI runs (type-check + unit tests).
# The backend suite needs Postgres/Redis, so it runs in the pre-push hook and in CI instead.
# Install once with `make hooks`. Bypass in an emergency with `git commit --no-verify` (CI still runs).
set -e
cd "$(git rev-parse --show-toplevel)"

run_check() {
	name="$1"
	shift
	printf "  %-30s " "$name..."
	if out=$("$@" 2>&1); then
		echo "✅ PASS"
	else
		echo "❌ FAIL"
		echo "$out" | sed 's/^/    /'
		exit 1
	fi
}

branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = "main" ]; then
	echo "❌ Direct commits to main are not allowed. Create a branch and open a pull request."
	exit 1
fi

echo "🔍 Running pre-commit checks..."
run_check "TypeScript type-check" npx tsc -b
run_check "Frontend unit tests" npx vitest run
echo "🎉 All pre-commit checks passed!"
