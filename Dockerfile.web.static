# The web image (frozen and scratch stacks, and Railway): the React app is built once, at image build time, and served by
# nginx. No dev server, no bind mounts. nginx runs as an unprivileged user and listens on $PORT (8080 unless Railway sets it).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html tsconfig.json vite.config.ts ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
# Defaults for docker compose; Railway sets PORT, and BACKEND_URL to the API's private address (see README: Deployment).
ENV PORT=8080 \
    BACKEND_URL=http://api:8100 \
    TRUSTED_PROXIES="" \
    REAL_IP_HEADER=X-Forwarded-For \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    NGINX_ENVSUBST_FILTER="^(PORT|BACKEND_URL|NGINX_LOCAL_RESOLVERS|NGINX_LISTEN_V6|NGINX_REAL_IP)$"
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --chmod=0755 nginx/16-resumaker.envsh /docker-entrypoint.d/16-resumaker.envsh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
