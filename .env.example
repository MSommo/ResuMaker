# Copy to .env (`make env` does). Read by the Python API (backend/) when it runs on your machine; never sent to the browser.
# docker compose sets the addresses itself (docker-compose*.yml); on Railway they are service variables (README: Deployment).

# Enables "Improve" and the AI assistant. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the data lives. Required: the API has no built-in default. These are the SCRATCH stack's host ports
# (`make infra`); the frozen stack (your real data) is on 5433 / 6380. postgres:// URLs are accepted too.
DATABASE_URL=postgresql+asyncpg://resumaker:resumaker@localhost:5434/resumaker
REDIS_URL=redis://localhost:6381/0

# Where headless Chrome loads the app to render PDFs (the Vite dev server of `make local-web`).
FRONTEND_URL=http://localhost:5173

# Optional (defaults shown)
# APP_ENV=development                  # production: refuses to start with unsafe settings, no /docs (see SECURITY.md)
# PUBLIC_URL=                          # the address people open (invite links, Secure cookies when https); defaults to FRONTEND_URL
# GEMINI_MODEL=gemini-flash-latest
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# AI_RATE_LIMIT_PER_MIN=30
