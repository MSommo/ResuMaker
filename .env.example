# Copy to .env. Read by the Python API (backend/); never sent to the browser.

# Enables "Improve" and the AI assistant. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# DATABASE_URL=postgresql+asyncpg://resumaker:resumaker@localhost:5433/resumaker
# REDIS_URL=redis://localhost:6380/0
# FRONTEND_URL=http://localhost:5173     # where headless Chrome loads the app to render PDFs
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# AI_RATE_LIMIT_PER_MIN=30
