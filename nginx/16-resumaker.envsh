#!/bin/sh
# Sourced by the nginx image's entrypoint (scripts in /docker-entrypoint.d run in name order): after 15-local-resolvers.envsh,
# which sets NGINX_LOCAL_RESOLVERS from /etc/resolv.conf, and before 20-envsubst-on-templates.sh fills in the template.
# Works out the template values that are more than a plain variable.

# Listen on IPv6 as well where the container has it: Railway's private network is IPv6 (the API's Chrome reaches us there).
if [ -f /proc/net/if_inet6 ]; then
    export NGINX_LISTEN_V6="listen [::]:${PORT};"
else
    export NGINX_LISTEN_V6=""
fi

# TRUSTED_PROXIES: space-separated addresses / CIDR ranges allowed to tell us the client's IP, in the header REAL_IP_HEADER
# (X-Forwarded-For by default, read from the right; on Railway use X-Real-IP, which its edge overwrites).
# Empty (the default) = nobody: every request is attributed to its TCP peer.
NGINX_REAL_IP=""
for p in ${TRUSTED_PROXIES:-}; do
    NGINX_REAL_IP="${NGINX_REAL_IP}set_real_ip_from ${p}; "
done
if [ -n "$NGINX_REAL_IP" ]; then
    NGINX_REAL_IP="${NGINX_REAL_IP}real_ip_header ${REAL_IP_HEADER:-X-Forwarded-For}; real_ip_recursive off;"
fi
export NGINX_REAL_IP
